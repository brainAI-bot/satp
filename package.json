{
  "name": "@brainai/satp-client",
  "private": true,
  "version": "0.0.0-extraction",
  "description": "SATP client SDK package root for commit-pinned Git consumption; npm publish remains blocked until the release packet passes.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/satp-client",
    "packages/satp-core",
    "packages/satp-solana",
    "packages/satp"
  ],
  "scripts": {
    "lint:roadmap": "node scripts/lint-roadmap.js",
    "validate:idls": "python3 scripts/validate-idls.py",
    "generate:v3-idls": "node scripts/generate-v3-idls.mjs",
    "check:v3-idl-program-metadata": "node scripts/check-v3-idl-program-metadata.mjs",
    "pack:satp-client": "mkdir -p dist && npm pack ./packages/satp-client --pack-destination dist",
    "check:satp-client-health": "node scripts/check-satp-client-package-health.js",
    "check:release-metadata": "node scripts/check-satp-release-metadata.js",
    "verify:v3-program-sources": "node scripts/verify-v3-program-sources.mjs",
    "check:js": "find packages/satp-client/src -name '*.js' -type f -print0 | xargs -0 -n1 node --check",
    "check:exports": "node scripts/check-exports.js",
    "test:package-entrypoints": "node tests/package-entrypoints.test.js",
    "smoke:consumer-install": "node scripts/smoke-clean-consumer-install.js",
    "smoke:satp-client-packed-consumer": "node scripts/smoke-satp-client-packed-consumer.js",
    "check:satp-client-uuid-advisory": "node scripts/check-satp-client-uuid-advisory.js",
    "check:examples": "npm --prefix examples/mcp-x402-readonly run check && npm --prefix examples/agentfolio-consumer-readonly run check && npm --prefix examples/third-party-runtime-conformance run check",
    "test:attestation-request": "node packages/satp-client/test-attestation-request.js",
    "test:runtime-policy": "node --test packages/satp-client/test-runtime-policy-adapter.js",
    "test:attestation-evidence": "node --test packages/satp-client/test-attestation-evidence.js",
    "test:runtime-authorization-evidence": "node --test packages/satp-client/test-runtime-authorization-evidence.js",
    "test:wallet-control": "node packages/satp-client/test-wallet-control-challenge.js",
    "test:x402-discovery": "node packages/satp-client/test-x402-discovery.js",
    "test:signer-policy": "node packages/satp-client/test-signer-policy.js",
    "test:conformance:rc-s6": "node tests/conformance/rc-s6-fixtures.test.js",
    "test:escrow-build-proof-reference": "node --test tests/escrow-v3-build-proof-reference.test.mjs",
    "test:escrow-mainnet-provenance": "node --test tests/escrow-v3-mainnet-provenance.test.mjs",
    "test:escrow-deployed-truth": "node --test tests/escrow-v3-deployed-truth.test.mjs",
    "test:escrow-mainnet-locked": "node --test tests/escrow-v3-mainnet-locked.test.mjs",
    "verify:escrow-fee-routing-extension": "node scripts/verify-escrow-v3-fee-routing-extension.mjs",
    "check:escrow-release-readiness": "node scripts/check-escrow-v3-release-readiness.mjs && node --test tests/escrow-v3-release-readiness-guard.test.mjs",
    "verify:escrow-mainnet-provenance:live": "node scripts/verify-escrow-v3-deployed-truth.mjs --live",
    "verify:escrow-deployed-source:live": "scripts/build-verify-escrow-v3-deployed-source.sh",
    "test:v3": "node packages/satp-client/test-v3.js",
    "test:v3-fee-routing": "node packages/satp-client/test-v3-escrow-fee-routing.js",
    "test:burn-become-devnet-e2e": "node scripts/burn-to-become-devnet-e2e.js --offline",
    "test:v3-usdc": "node packages/satp-client/test-v3-escrow-usdc.js",
    "test:borsh": "node packages/satp-client/test-borsh-reader.js",
    "test:examples": "npm --prefix examples/mcp-x402-readonly test && npm --prefix examples/agentfolio-consumer-readonly test && npm --prefix examples/third-party-runtime-conformance test",
    "ci:offline": "npm run lint:roadmap && npm run validate:idls && npm run check:v3-idl-program-metadata && npm run verify:v3-program-sources && npm run check:js && npm run check:exports && npm run check:release-metadata && npm run test:package-entrypoints && npm run test:attestation-request && npm run test:runtime-policy && npm run test:attestation-evidence && npm run test:runtime-authorization-evidence && npm run test:wallet-control && npm run test:x402-discovery && npm run test:signer-policy && npm run test:conformance:rc-s6 && npm run test:escrow-build-proof-reference && npm run test:escrow-mainnet-provenance && npm run test:escrow-deployed-truth && npm run test:escrow-mainnet-locked && npm run check:escrow-release-readiness && npm run test:v3 && npm run test:v3-fee-routing && npm run test:v3-usdc && npm run test:borsh",
    "ci:offline-with-examples": "npm run ci:offline && npm run check:examples && npm run test:examples",
    "ci": "npm run ci:offline && npm run smoke:consumer-install && npm run smoke:satp-client-packed-consumer && npm run check:satp-client-uuid-advisory"
  },
  "main": "packages/satp-client/src/index.js",
  "types": "packages/satp-client/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/satp-client/src/index.d.ts",
      "default": "./packages/satp-client/src/index.js"
    },
    "./wallet-control-challenge": {
      "types": "./packages/satp-client/src/index.d.ts",
      "default": "./packages/satp-client/src/wallet-control-challenge.js"
    },
    "./attestation-evidence": {
      "types": "./packages/satp-client/src/index.d.ts",
      "default": "./packages/satp-client/src/attestation-evidence.js"
    },
    "./runtime-authorization-evidence": {
      "types": "./packages/satp-client/src/index.d.ts",
      "default": "./packages/satp-client/src/runtime-authorization-evidence.js"
    },
    "./x402-discovery": {
      "types": "./packages/satp-client/src/index.d.ts",
      "default": "./packages/satp-client/src/x402-discovery.js"
    },
    "./src/*": "./packages/satp-client/src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "docs/adoption-quickstarts.md",
    "docs/quickstart.md",
    "docs/agentfolio-consumption-readiness.md",
    "docs/package-boundary.md",
    "docs/runtime-policy-adapter-v0.md",
    "docs/runtime-authorization-evidence-v0.md",
    "docs/satp-client-consumer-install.md",
    "idls/",
    "packages/satp-client/examples/",
    "packages/satp-client/README.md",
    "packages/satp-client/index.js",
    "packages/satp-client/package.json",
    "packages/satp-client/src/"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "borsh": "^2.0.0",
    "bs58": "^6.0.0",
    "rpc-websockets": "9.3.5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "rpc-websockets": "9.3.5",
    "jayson": {
      "uuid": "^11.1.1"
    }
  }
}
